<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_app"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMembersBack"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="‹  Back to expenses"
        android:textAllCaps="false"
        android:textColor="@color/brand_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GROUP MEMBERS"
        android:textColor="@color/brand_teal_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/tvMembersGroupName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Members"
        android:textColor="@color/ink"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvMembersCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading members…"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvMembersOwner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="-10dp"
        android:layout_marginBottom="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddMember"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="＋  Add a person"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="@color/brand_teal"
        app:cornerRadius="16dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutOwnerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRenameGroup"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Edit group"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            app:strokeColor="@color/card_outline"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Delete group"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/error"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLeaveGroup"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Leave group"
        android:textAllCaps="false"
        android:textColor="@color/error"
        app:strokeColor="@color/error"
        app:cornerRadius="14dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMembersError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/error"
        android:textSize="14sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <ProgressBar
        android:id="@+id/progressMembers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/brand_teal" />

    <TextView
        android:id="@+id/tvMembersEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No members found. Add someone to start sharing expenses."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
