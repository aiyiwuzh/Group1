<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="‹  Back"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvFormHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Expense"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:layout_marginBottom="20dp" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Title" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Expense title"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/brand_teal"
            android:layout_marginBottom="16dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExpenseTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Amount ($)" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Amount"
            app:prefixText="$"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/brand_teal"
            android:layout_marginBottom="16dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExpenseAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Category" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etCustomCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom category name"
            android:singleLine="true"
            android:maxLength="50"
            android:visibility="gone"
            android:layout_marginTop="-12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Paid by" />

        <Spinner
            android:id="@+id/spPayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Everyone starts selected. The payer is included automatically."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="-8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Split between (at least 2, including the payer)" />

        <LinearLayout
            android:id="@+id/layoutParticipants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="How should this be split?" />

        <Spinner
            android:id="@+id/spSplitMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSplitHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutSplitValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviewSplit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Preview split"
            android:textAllCaps="false"
            android:textColor="@color/brand_teal"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            app:strokeColor="@color/brand_teal"
            app:strokeWidth="1dp"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSplitPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:background="@drawable/bg_summary_card"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Note (optional)" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Note (optional)"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeColor="@color/brand_teal"
            android:layout_marginBottom="24dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etExpenseNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minLines="2"
                android:gravity="top" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttachReceipt"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Attach receipt photo (optional)"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            app:strokeColor="@color/card_outline"
            app:cornerRadius="14dp"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveExpense"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Expense"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_teal"
            app:cornerRadius="16dp"
            android:enabled="false" />

        <TextView
            android:id="@+id/tvExpenseError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
