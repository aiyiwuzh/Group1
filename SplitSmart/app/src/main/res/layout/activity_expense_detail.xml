<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1E293B" />

        <TextView
            android:id="@+id/tvDetailAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDetailLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This expense is covered by a settlement, so it can't be edited or deleted."
            android:textSize="14sp"
            android:textColor="#92400E"
            android:background="#FEF3C7"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Category" />

        <TextView
            android:id="@+id/tvDetailCategory"
            style="@style/ExpenseDetailValue" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Paid by" />

        <TextView
            android:id="@+id/tvDetailPayer"
            style="@style/ExpenseDetailValue" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Split between" />

        <TextView
            android:id="@+id/tvDetailParticipants"
            style="@style/ExpenseDetailValue" />

        <TextView
            android:id="@+id/tvDetailNoteLabel"
            style="@style/ExpenseFieldLabel"
            android:text="Note" />

        <TextView
            android:id="@+id/tvDetailNote"
            style="@style/ExpenseDetailValue" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Created" />

        <TextView
            android:id="@+id/tvDetailCreated"
            style="@style/ExpenseDetailValue" />

        <Button
            android:id="@+id/btnEditExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Expense"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDeleteExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Expense"
            android:backgroundTint="#DC2626"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDetailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#DC2626"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
