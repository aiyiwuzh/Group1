<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="‹  Back"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/tvDetailAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/brand_ink"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDetailLocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This expense is marked settled, so it can't be edited or deleted."
            android:textSize="14sp"
            android:textColor="#81530B"
            android:background="@drawable/bg_warning_card"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Category" />

        <TextView
            android:id="@+id/tvDetailCategory"
            style="@style/ExpenseDetailValue" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Paid by" />

        <TextView
            android:id="@+id/tvDetailPayer"
            style="@style/ExpenseDetailValue" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Split between" />

        <TextView
            android:id="@+id/tvDetailParticipants"
            style="@style/ExpenseDetailValue" />

        <TextView
            android:id="@+id/tvDetailNoteLabel"
            style="@style/ExpenseFieldLabel"
            android:text="Note" />

        <TextView
            android:id="@+id/tvDetailNote"
            style="@style/ExpenseDetailValue" />

        <TextView
            style="@style/ExpenseFieldLabel"
            android:text="Created" />

        <TextView
            android:id="@+id/tvDetailCreated"
            style="@style/ExpenseDetailValue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkSettledExpense"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Mark as settled"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_teal"
            app:cornerRadius="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditExpense"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Edit Expense"
            android:textAllCaps="false"
            android:textColor="@color/brand_ink"
            app:strokeColor="@color/card_outline"
            app:cornerRadius="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteExpense"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Delete Expense"
            android:textAllCaps="false"
            android:backgroundTint="@color/error"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDetailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
