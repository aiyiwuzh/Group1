<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_app">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSettlementBack"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="‹  Back"
        android:textAllCaps="false"
        android:textColor="@color/brand_ink"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="14dp" />

    <TextView
        android:id="@+id/tvSettlementTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Record a payment"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tvSettlementPayee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payment to member"
        android:textSize="17sp"
        android:textColor="@color/brand_ink"
        android:layout_marginTop="20dp" />

    <TextView
        android:id="@+id/tvSettlementMaximum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Current amount owed: $0.00"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_summary_card"
        android:padding="14dp"
        android:layout_marginTop="6dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Payment amount"
        app:prefixText="$"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="@color/brand_teal"
        android:layout_marginTop="20dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSettlementAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Note (optional)"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="@color/brand_teal"
        android:layout_marginTop="14dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSettlementNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="500"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the amount you paid outside the app. Partial payments are allowed."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvSettlementError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/error"
        android:visibility="gone"
        android:layout_marginTop="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveSettlement"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save payment"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="@color/brand_teal"
        app:cornerRadius="16dp"
        android:layout_marginTop="20dp" />
  </LinearLayout>
</ScrollView>
