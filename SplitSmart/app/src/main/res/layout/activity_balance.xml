<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface_app">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBalanceBack"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="‹  Back"
        android:textAllCaps="false"
        android:textColor="@color/brand_ink"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="14dp" />

    <TextView
        android:id="@+id/tvBalanceGroupName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Group balances"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Payments are recorded here; SplitSmart does not transfer money."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvBalanceTotals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You owe $0.00  ·  You are owed $0.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/brand_ink"
        android:padding="12dp"
        android:background="@drawable/bg_summary_card" />

    <TextView
        android:id="@+id/tvBalanceError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/error"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Balances with group members"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvNoBalances"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No other members in this group yet."
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                android:padding="8dp" />

            <LinearLayout
                android:id="@+id/layoutBalanceRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recorded settlements"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSettlementError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/error"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvNoSettlements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No settlements have been recorded."
                android:textColor="@color/text_secondary"
                android:visibility="gone"
                android:padding="8dp" />

            <LinearLayout
                android:id="@+id/layoutSettlementRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
